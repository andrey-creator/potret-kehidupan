{
  "name": "potret-kehidupan",
  "version": "1.0.0",
  "private": true,
  "description": "Galeri foto personal full-stack dengan Cloudflare Pages, D1, dan R2.",
  "scripts": {
    "build": "node scripts/build.mjs && tsc",
